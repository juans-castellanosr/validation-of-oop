    +state() long
  }
  EnvironmentEvent <|-- ColdSnap
  EnvironmentEvent ..> Ocean
  EventScheduler "1" *-- "*" EnvironmentEvent : active
  EventScheduler ..> Species
  EventScheduler ..> Ocean
  EventState --> EventType : type
  EnvironmentEvent <|-- FoodShower
  Surroundings <|.. Ocean
  Ocean --> ResumableRandom : random
  Ocean --> "*" Species : residents
  Ocean "1" *-- EventScheduler : events
  Ocean "1" *-- "*" Creature : creatures
  Ocean "1" *-- "*" Creature : births
  Ocean "1" *-- "*" FoodParticle : food
  Ocean --> Vector2 : current
  Ocean ..> HabitatViolationException
  EnvironmentEvent <|-- OceanCurrent
  EnvironmentEvent <|-- PredatorArrival
  PredatorArrival --> Species : predator
