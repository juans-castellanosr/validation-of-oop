    #canReproduce() boolean
    +consume() boolean
    #cruiseSpeed() double
    #destination() Vector2
    #digestTime() double
    +foodPoints() double
    #growthPoints() double
    +healthLevel() double
    -hurt(amount : double) void
    +isPlayer() boolean
    +isRecovering() boolean
    #live(world : Surroundings, dt : double) void
    +lungs() Lungs
    #metabolism() double
    +nutrition() double
    #onAte(food : Edible) void
    +oxygenLevel() double
    #protectionSeconds() double
    #restore(state : CreatureState) void
    +stage() GrowthStage
