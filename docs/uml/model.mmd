  class SchoolingFish {
    -THREAT_SIGHT : double$
    -FOOD_SIGHT : double$
    -SCHOOL_RADIUS : double$
    +SchoolingFish(id : long, species : Species, position : Vector2, sizeMeters : double, energy : double)
    #allowedBand() Range~Double~
    #cruiseSpeed() double
    #maturitySeconds() double
    #maxSpeed(world : Surroundings) double
    #metabolism() double
    #steer(world : Surroundings, dt : double) Vector2
  }
  class SeafloorDweller {
    +RESTING_BAND : Range~Double~$
    +SeafloorDweller(id : long, species : Species, position : Vector2, sizeMeters : double, energy : double)
    #allowedBand() Range~Double~
    #cruiseSpeed() double
    #currentExposure() double
    #maturitySeconds() double
    #metabolism() double
    #reach() double
    #steer(world : Surroundings, dt : double) Vector2
