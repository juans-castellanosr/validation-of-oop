  class Surroundings {
    <<interface>>
    +activityFactor()* double «abstract»
    +currentAt(point : Vector2)* Vector2 «abstract»
    +height()* double «abstract»
    +hunterSpeedFactor()* double «abstract»
    +nearestEdible(eater : Creature, radius : double)* Optional~Edible~ «abstract»
    +nearestThreat(target : Creature, radius : double)* Optional~Creature~ «abstract»
    +random()* Random «abstract»
    +requestOffspring(parent : Creature)* boolean «abstract»
    +sameSpeciesNear(creature : Creature, radius : double)* List~Creature~ «abstract»
    +width()* double «abstract»
  }
  class Vector2 {
    <<record>>
    -x : double
    -y : double
    +ZERO : Vector2$
    +distanceTo(o : Vector2) double
    +length() double
    +lerp(target : Vector2, t : double) Vector2
    +limit(max : double) Vector2
    +minus(o : Vector2) Vector2
    +normalized() Vector2
    +plus(o : Vector2) Vector2
    +times(factor : double) Vector2
  }
  AirBreather ..> Lungs
  Entity <|-- Creature
  Edible <|.. Creature
  Creature --> Species : species
  Creature --> Vector2 : velocity
  Creature ..> Range
  Creature ..> Surroundings
  CreatureFactory ..> Species
  CreatureFactory ..> Creature
  CreatureFactory ..> PlayerCreature
  CreatureState --> Vector2 : destination
  Creature <|-- Drifter
  Drifter --> Vector2 : jetDirection
  Edible ..> Species
  Entity --> Vector2 : position
  Entity <|-- FoodParticle
  Edible <|.. FoodParticle
  Creature <|-- Hunter
  Hunter <|-- MarineReptile
  AirBreather <|.. MarineReptile
  MarineReptile "1" *-- Lungs : lungs
  Creature <|-- PlayerCreature
  AirBreather <|.. PlayerCreature
  PlayerCreature "1" *-- Lungs : lungs
  PlayerCreature --> Vector2 : direction
  PlayerCreature --> Vector2 : destination
  Creature <|-- SchoolingFish
  Creature <|-- SeafloorDweller
  Surroundings ..> Creature
  Surroundings ..> Edible
